; Engine configuration file.
; Taht ve Kılıç — mobil (dikey) KingsAge klonu.
; Bu dosya yalnızca A-HALKA ajanı tarafından yönetilir.

config_version=5

[application]

config/name="Taht ve Kılıç"
config/description="Kralın tahtı, kılıcı ve köyü. KingsAge mekaniklerinin mobil dikey klonu."
run/main_scene="res://scenes/VillageSelect.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.047, 0.078, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameConfig="*res://autoload/GameConfig.gd"
GameData="*res://autoload/GameData.gd"
GameState="*res://autoload/GameState.gd"
GameClock="*res://autoload/GameClock.gd"
GameLoop="*res://scripts/core/GameLoop.gd"
SaveManager="*res://autoload/SaveManager.gd"
WorldManager="*res://autoload/WorldManager.gd"
AuthManager="*res://autoload/AuthManager.gd"
NetworkManager="*res://autoload/NetworkManager.gd"
StoreManager="*res://autoload/StoreManager.gd"
LordManager="*res://autoload/LordManager.gd"
VillageBackgroundCache="*res://autoload/VillageBackgroundCache.gd"
TutorialManager="*res://autoload/TutorialManager.gd"
QuestManager="*res://autoload/QuestManager.gd"
NotificationManager="*res://autoload/NotificationManager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/dpi/allow_hidpi=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[gui]

common/snap_controls_to_pixels=true
theme/custom="res://themes/TahtVeKilic.tres"

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

