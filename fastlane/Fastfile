default_platform(:ios)

platform :ios do
  def setup_ci_keychain_and_wwdr
    kc_name     = "ci_signing"
    kc_password = "ci_signing_password"
    kc_path     = File.expand_path("~/Library/Keychains/#{kc_name}-db")

    create_keychain(
      name: kc_name,
      password: kc_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    ["AppleWWDRCAG3.cer", "AppleWWDRCAG6.cer"].each do |cert_name|
      local = "/tmp/#{cert_name}"
      sh("curl -fsSL 'https://www.apple.com/certificateauthority/#{cert_name}' -o '#{local}'")
      import_certificate(
        certificate_path: local,
        keychain_path: kc_path,
        keychain_password: kc_password
      )
    end

    [kc_name, kc_password, kc_path]
  end

  def asc_api_key
    key_id    = ENV.fetch("ASC_KEY_ID", "")
    issuer_id = ENV.fetch("ASC_ISSUER_ID", "")
    key_path  = ENV.fetch("ASC_KEY_PATH", "")
    UI.user_error!("Missing ASC_KEY_ID") if key_id.empty?
    UI.user_error!("Missing ASC_ISSUER_ID") if issuer_id.empty?
    UI.user_error!("Missing ASC_KEY_PATH file: #{key_path}") unless File.exist?(key_path)

    key_content = File.read(key_path)
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )
    [api_key, key_id, issuer_id, key_content]
  end

  desc "Create CI keychain, install Apple Distribution cert & App Store provisioning profile before Godot export"
  lane :prepare_signing do
    team_id   = ENV.fetch("APPLE_TEAM_ID", "H2TTF8894Z")
    bundle_id = ENV.fetch("APP_BUNDLE_ID", "com.tahtkilic.kingsage2")
    out_env   = ENV.fetch("SIGNING_ENV_FILE", File.expand_path("../build/signing.env", __dir__))

    _, _, kc_path = setup_ci_keychain_and_wwdr
    kc_password = "ci_signing_password"
    api_key, key_id, issuer_id, key_content = asc_api_key

    require "spaceship"
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: key_id,
        issuer_id: issuer_id,
        key: key_content
      )
      Spaceship::ConnectAPI.token = token
      dist_certs = Spaceship::ConnectAPI::Certificate.all.select { |c|
        ["DISTRIBUTION", "IOS_DISTRIBUTION"].include?(c.certificate_type)
      }
      UI.message("Active Distribution certs on Apple portal: #{dist_certs.length}")
      # Apple Individual accounts allow up to 2 active Distribution certs.
      if dist_certs.length >= 2
        dist_certs.take(dist_certs.length - 1).each do |c|
          UI.message("Revoking oldest Distribution cert #{c.id} (#{c.display_name}) to free slot")
          c.delete!
        end
      end
    rescue => e
      UI.important("Cert quota precheck note: #{e.message}")
    end

    apple_signin_enabled = false
    begin
      bid = Spaceship::ConnectAPI::BundleId.find(bundle_id)
      if bid
        caps = bid.get_capabilities rescue []
        apple_signin_enabled = caps.any? { |c| c.capability_type.to_s == "APPLE_ID_AUTH" }
        unless apple_signin_enabled
          UI.message("Attempting to enable Sign In with Apple (APPLE_ID_AUTH) capability on #{bundle_id}...")
          bid.create_capability(
            "APPLE_ID_AUTH",
            settings: [
              {
                key: "ENABLE_INDIVIDUAL_USER_MIGRATION",
                options: []
              }
            ]
          ) rescue bid.create_capability("APPLE_ID_AUTH")
          caps = bid.get_capabilities rescue []
          apple_signin_enabled = caps.any? { |c| c.capability_type.to_s == "APPLE_ID_AUTH" }
        end
        UI.message("Sign In with Apple capability active: #{apple_signin_enabled}")
      end
    rescue => e
      UI.important("Sign In with Apple capability check note: #{e.message}")
    end

    cert(
      api_key: api_key,
      team_id: team_id,
      platform: "ios",
      keychain_path: kc_path,
      keychain_password: kc_password
    )

    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      team_id: team_id,
      platform: "ios",
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME].to_s
    profile_uuid = lane_context[SharedValues::SIGH_UDID].to_s
    UI.user_error!("SIGH failed to produce profile UUID") if profile_uuid.empty?

    sh("mkdir -p '#{File.dirname(out_env)}'")
    File.write(out_env, "ASC_PROFILE_NAME=#{profile_name}\nASC_PROFILE_UUID=#{profile_uuid}\nASC_APPLE_SIGNIN_ENABLED=#{apple_signin_enabled ? '1' : '0'}\n")
    UI.success("Prepared signing profile #{profile_name} (#{profile_uuid}), apple_signin=#{apple_signin_enabled}")
  end

  desc "Export IPA from Godot Xcode archive and upload to TestFlight"
  lane :export_and_upload do |options|
    team_id      = ENV.fetch("APPLE_TEAM_ID", "H2TTF8894Z")
    bundle_id    = ENV.fetch("APP_BUNDLE_ID", "com.tahtkilic.kingsage2")
    profile_name = ENV.fetch("ASC_PROFILE_NAME", "")
    project_arg  = options[:project_path] || File.expand_path("../build/ios/TahtVeKilic.xcodeproj", __dir__)
    scheme_name  = options[:scheme] || "TahtVeKilic"
    target_name  = options[:target] || scheme_name
    build_num    = ENV.fetch("BUILD_NUMBER", "1")
    build_dir    = File.dirname(project_arg)
    archive_path = "#{build_dir}/TahtVeKilic.xcarchive"
    ipa_dir      = "#{build_dir}/ipa"

    UI.user_error!("Missing ASC_PROFILE_NAME") if profile_name.empty?
    api_key, = asc_api_key

    # Archive via Xcode if Godot didn't already produce a complete .xcarchive
    unless Dir.exist?("#{archive_path}/Products/Applications")
      UI.message("Enforcing Manual App Store code signing on #{target_name}...")
      update_code_signing_settings(
        path: project_arg,
        targets: [target_name],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        bundle_identifier: bundle_id
      )
      UI.message("Archiving #{project_arg} (#{scheme_name})...")
      sh("xcodebuild archive -project '#{project_arg}' -scheme '#{scheme_name}' -configuration Release -destination 'generic/platform=iOS' -archivePath '#{archive_path}' DEVELOPMENT_TEAM='#{team_id}' CURRENT_PROJECT_VERSION='#{build_num}' MARKETING_VERSION='1.0.0' CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' PRODUCT_BUNDLE_IDENTIFIER='#{bundle_id}'")
    end

    sh("mkdir -p '#{ipa_dir}'")
    export_plist = "#{build_dir}/ExportOptions.plist"
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>teamID</key>
        <string>#{team_id}</string>
        <key>uploadSymbols</key>
        <true/>
        <key>provisioningProfiles</key>
        <dict>
          <key>#{bundle_id}</key>
          <string>#{profile_name}</string>
        </dict>
      </dict>
      </plist>
    PLIST

    sh("xcodebuild -exportArchive -archivePath '#{archive_path}' -exportOptionsPlist '#{export_plist}' -exportPath '#{ipa_dir}' DEVELOPMENT_TEAM='#{team_id}'")

    ipa_file = Dir["#{ipa_dir}/*.ipa"].first
    UI.user_error!("No .ipa file produced in #{ipa_dir}") unless ipa_file && File.exist?(ipa_file)
    UI.message("Uploading IPA to TestFlight: #{ipa_file}")

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: ipa_file,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      uses_non_exempt_encryption: false
    )

    delete_keychain(name: "ci_signing")
    UI.success("TestFlight upload completed cleanly!")
  end
end
